.reader { background: var(--surface); min-height: 100vh; }
.rtools { position: sticky; top: 0; z-index: 4; display: flex; gap: 12rpx; padding: 16rpx 24rpx; background: var(--surface); border-bottom: 2rpx solid var(--line); }
.tool { border: 2rpx solid var(--line); border-radius: 999rpx; padding: 10rpx 22rpx; font-size: 26rpx; font-weight: 600; }
.tool.on { background: var(--soft); border-color: var(--accent); color: var(--accent); }
.rart { padding: 40rpx 40rpx 8rpx; }
.rkicker { font-size: 22rpx; font-weight: 800; letter-spacing: 3rpx; text-transform: uppercase; }
.rtitle { font-size: 56rpx; line-height: 1.12; margin: 16rpx 0 20rpx; font-weight: 700; }
.rdek { font-style: italic; font-size: 32rpx; line-height: 1.5; color: var(--muted); margin-bottom: 24rpx; }
.rmeta { font-size: 24rpx; color: var(--muted); padding-bottom: 28rpx; border-bottom: 2rpx solid var(--line); margin-bottom: 36rpx; }
.rp { display: flex; gap: 16rpx; margin: 0 -16rpx 36rpx; padding: 8rpx 16rpx; border-radius: 20rpx; }
.rp.playing { background: #eaf6f4; }
.rpn { font-size: 22rpx; color: var(--muted); padding-top: 14rpx; font-weight: 700; width: 28rpx; flex-shrink: 0; }
.rtext { flex: 1; font-size: 34rpx; line-height: 1.78; }
.fs2 .rtext { font-size: 38rpx; } .fs3 .rtext { font-size: 42rpx; }
.kw { font-weight: 600; background: linear-gradient(transparent 55%, var(--kwbg) 55%); }
.ks { background: var(--hlbg); border-bottom: 4rpx solid var(--hl); }
.rsrc { font-size: 24rpx; color: var(--muted); padding: 24rpx 0 32rpx; border-top: 2rpx solid var(--line); }
.ctr { align-items: center; text-align: center; }
.sw { font-size: 52rpx; font-weight: 800; } .small { font-size: 28rpx; font-weight: 400; }
.ks-sheet { border-top-color: var(--hl); }
.kind { font-size: 24rpx; font-weight: 800; letter-spacing: 2rpx; text-transform: uppercase; color: var(--hl); }
.squote { font-size: 34rpx; line-height: 1.6; font-style: italic; }
.ksf { background: var(--hlbg); }
