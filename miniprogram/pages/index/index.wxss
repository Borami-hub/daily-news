.dstrip { white-space: nowrap; margin: 0 -32rpx; padding: 4rpx 32rpx 8rpx; width: auto; }
.dchip { display: inline-flex; flex-direction: column; align-items: center; width: 124rpx; padding: 16rpx 0 14rpx; margin-right: 16rpx; border-radius: 28rpx; border: 3rpx solid var(--line); background: var(--surface); }
.dchip.on { background: var(--ink); border-color: var(--ink); color: #fff; }
.dwd { font-size: 21rpx; font-weight: 700; letter-spacing: 1rpx; text-transform: uppercase; opacity: .75; }
.dnum { font-size: 44rpx; font-weight: 800; line-height: 1.1; }
.dmon { font-size: 21rpx; opacity: .7; }
.ddots { display: flex; gap: 6rpx; margin-top: 6rpx; }
.dd { width: 10rpx; height: 10rpx; border-radius: 50%; background: currentColor; opacity: .25; }
.dd.f { background: var(--good); opacity: 1; }
.name-row { display: flex; align-items: center; gap: 16rpx; background: var(--surface); border: 2rpx solid var(--line); border-radius: 999rpx; padding: 8rpx 28rpx; height: 76rpx; }
.story { display: flex; align-items: center; gap: 24rpx; background: var(--surface); border: 2rpx solid var(--line); border-left: 8rpx solid; border-radius: 24rpx; padding: 28rpx; }
.sn { font-size: 48rpx; font-weight: 800; width: 44rpx; }
.sbody { display: flex; flex-direction: column; gap: 6rpx; flex: 1; min-width: 0; }
.topic { font-size: 22rpx; font-weight: 700; letter-spacing: 2rpx; text-transform: uppercase; }
.cal { display: grid; grid-template-columns: repeat(14, 1fr); gap: 8rpx; }
.cell { height: 36rpx; border-radius: 8rpx; background: var(--line); }
.cell.on { background: var(--accent); } .cell.part { background: #8cc7c2; } .cell.today { box-shadow: 0 0 0 3rpx var(--ink); }
