page {
  --bg: #edf3f4; --surface: #ffffff; --soft: #e1edef; --ink: #0f2a33; --muted: #557079; --line: #cfdde0;
  --accent: #0b7a75; --amber: #b86e0c; --good: #1d8549; --bad: #bf3f2b; --goodbg: #e2f3e8; --badbg: #fbe9e5;
  --hl: #c98a00; --hlbg: #fff1bf; --kwbg: #cfeee9;
  background: var(--bg); color: var(--ink);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif; font-size: 28rpx;
}
.serif { font-family: Georgia, "Times New Roman", "Songti SC", serif; }
.wrap { padding: 32rpx 32rpx 80rpx; display: flex; flex-direction: column; gap: 28rpx; }
.eyebrow { font-size: 22rpx; letter-spacing: 3rpx; text-transform: uppercase; color: var(--muted); font-weight: 600; }
.h1 { font-size: 48rpx; font-weight: 800; line-height: 1.2; }
.h2 { font-size: 38rpx; font-weight: 700; line-height: 1.3; }
.h3 { font-size: 32rpx; font-weight: 700; line-height: 1.35; }
.muted { color: var(--muted); } .meta { font-size: 24rpx; color: var(--muted); line-height: 1.5; }
.panel { background: var(--surface); border: 2rpx solid var(--line); border-radius: 24rpx; padding: 32rpx; display: flex; flex-direction: column; gap: 22rpx; }
.row { display: flex; gap: 16rpx; flex-wrap: wrap; align-items: center; }
.spread { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.btn { background: var(--accent); color: #fff; border-radius: 999rpx; padding: 22rpx 36rpx; font-size: 30rpx; font-weight: 600; text-align: center; }
.btn.dim { opacity: .4; }
.ghost { border: 2rpx solid var(--line); color: var(--ink); border-radius: 999rpx; padding: 18rpx 32rpx; font-size: 28rpx; text-align: center; background: var(--surface); }
.flex1 { flex: 1; }
.chip { display: inline-block; font-size: 22rpx; border-radius: 999rpx; padding: 4rpx 18rpx; background: var(--soft); color: var(--accent); font-weight: 600; }
.chip.good { background: var(--goodbg); color: var(--good); } .chip.bad { background: var(--badbg); color: var(--bad); }
.chip.term { background: #efe7fb; color: #6741c7; }
.bar { height: 12rpx; background: var(--line); border-radius: 12rpx; overflow: hidden; }
.bar .fill { height: 100%; background: var(--accent); }
.big { font-size: 64rpx; font-weight: 800; color: var(--accent); line-height: 1; }
.stars { color: var(--amber); letter-spacing: 2rpx; }
.fact { border-left: 6rpx solid var(--accent); background: var(--soft); border-radius: 0 16rpx 16rpx 0; padding: 16rpx 22rpx; font-size: 28rpx; line-height: 1.5; }
.fb { border-radius: 16rpx; padding: 16rpx 22rpx; font-size: 28rpx; font-weight: 600; }
.fb.ok { background: var(--goodbg); color: var(--good); } .fb.no { background: var(--badbg); color: var(--bad); }
.opt { display: flex; gap: 14rpx; border: 2rpx solid var(--line); background: var(--bg); border-radius: 18rpx; padding: 22rpx 26rpx; font-size: 30rpx; line-height: 1.45; }
.opt.right { background: var(--goodbg); border-color: var(--good); color: var(--good); }
.opt.wrong { background: var(--badbg); border-color: var(--bad); color: var(--bad); }
.opt.chosen { border-color: var(--accent); background: var(--soft); color: var(--accent); font-weight: 600; }
.ol { font-weight: 800; color: var(--muted); width: 36rpx; flex-shrink: 0; }
.input { background: var(--bg); border: 2rpx solid var(--line); border-radius: 18rpx; padding: 0 24rpx; height: 88rpx; font-size: 32rpx; }
.mark { background: var(--hlbg); border-bottom: 4rpx solid var(--hl); }
.hlq { font-size: 30rpx; line-height: 1.65; background: var(--hlbg); border-left: 6rpx solid var(--hl); border-radius: 0 16rpx 16rpx 0; padding: 18rpx 24rpx; }
.say { color: var(--accent); font-weight: 600; font-size: 26rpx; padding: 6rpx 18rpx; border-radius: 999rpx; background: var(--soft); }
.list { background: var(--surface); border: 2rpx solid var(--line); border-radius: 24rpx; overflow: hidden; }
.item { display: flex; align-items: center; gap: 20rpx; padding: 28rpx 32rpx; border-top: 2rpx solid var(--line); }
.item.first { border-top: 0; }
.go { font-size: 52rpx; color: var(--muted); line-height: 1; }
.sheet-bg { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(15, 42, 51, .35); z-index: 10; }
.sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 11; background: var(--surface); border-radius: 44rpx 44rpx 0 0; border-top: 10rpx solid var(--accent); padding: 24rpx 36rpx calc(44rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; gap: 20rpx; }
.sfact { background: var(--soft); border-radius: 20rpx; padding: 20rpx 24rpx; font-size: 28rpx; line-height: 1.55; }
textarea.ta { width: 100%; box-sizing: border-box; min-height: 400rpx; font-size: 30rpx; line-height: 1.7; background: var(--bg); border-radius: 16rpx; padding: 20rpx; }
textarea.ta.short { min-height: 220rpx; }
.dots { display: flex; gap: 12rpx; flex-wrap: wrap; }
.dot { width: 68rpx; height: 68rpx; border-radius: 50%; border: 3rpx solid var(--line); background: var(--surface); font-weight: 700; font-size: 26rpx; color: var(--muted); display: flex; align-items: center; justify-content: center; }
.dot.done { background: var(--soft); border-color: var(--accent); color: var(--accent); }
.dot.cur { box-shadow: 0 0 0 4rpx var(--ink); }
.dot.ok { background: var(--goodbg); border-color: var(--good); color: var(--good); }
.dot.no { background: var(--badbg); border-color: var(--bad); color: var(--bad); }
.you { font-size: 20rpx; font-weight: 700; text-transform: uppercase; letter-spacing: 1rpx; margin-left: 10rpx; opacity: .8; }
